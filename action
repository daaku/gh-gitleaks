#!/usr/bin/env bash

# Installs gitleaks and scans the repository, reusing a cached copy when one is
# already present. Set GITLEAKS_VERSION to pin a release, or leave it unset to
# use the latest.

set -euo pipefail
trap 'echo "${0} line ${LINENO} Status: ${?}"' ERR

GITLEAKS_DIR=${GITLEAKS_DIR:-${RUNNER_TOOL_CACHE:-$HOME/.cache}/gitleaks}
GITLEAKS_BIN=${GITLEAKS_DIR}/gitleaks

gitleaks_url() {
  curl -fsSL "https://api.github.com/repos/gitleaks/gitleaks/releases/latest" |
    grep -m 1 "browser_download_url.*linux_x64.tar.gz" |
    cut -d ":" -f 2,3 |
    tr -d ' "'
}

if [[ ! -x $GITLEAKS_BIN ]]; then
  if [[ -n ${GITLEAKS_VERSION:-} ]]; then
    version=${GITLEAKS_VERSION#v}
    url="https://github.com/gitleaks/gitleaks/releases/download/v${version}/gitleaks_${version}_linux_x64.tar.gz"
  else
    url=$(gitleaks_url)
  fi
  mkdir -p "$GITLEAKS_DIR"
  curl -fsSL "$url" | tar -xz -C "$GITLEAKS_DIR" gitleaks
  chmod +x "$GITLEAKS_BIN"
fi

"$GITLEAKS_BIN" dir --redact=50 --report-format csv --report-path -
